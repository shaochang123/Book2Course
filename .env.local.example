# 复制为 .env.local 后按本机模型名调整；.env.local 已加入 .gitignore。
ZHIJIANG_LLM_PROVIDER=ollama
ZHIJIANG_LLM_BASE_URL=http://127.0.0.1:11434
ZHIJIANG_LLM_MODEL=qwen3:4b-instruct
# 可切换思考的模型达到结构化输出预算时可设 false；仅使用服务声明支持的开关。
ZHIJIANG_OLLAMA_SEMANTIC_THINKING=true
# 可选：限制 GPU 层数，为桌面应用保留显存；空值由 Ollama 自动决定。
# 8GB 显存本机测试使用 24。0 为 CPU；不必在其他机器照搬。
ZHIJIANG_OLLAMA_NUM_GPU=
# 可选：使用 /api/show 返回的字符串推理档位，例如 low；空值使用服务默认。
# 只有布尔开关的模型仍沿用 SEMANTIC_THINKING；不能靠模型名称猜测支持档位。
ZHIJIANG_OLLAMA_THINKING_LEVEL=

# 本机 Qwen3-TTS 参考声线；按 docs/自然讲解配音.md 安装隔离环境、模型与参考段。
# Ollama 自身不提供本项目需要的 /audio/speech WAV 接口。
ZHIJIANG_TTS_BASE_URL=http://127.0.0.1:8766/v1
ZHIJIANG_TTS_MODEL=qwen3-tts-0.6b-base
ZHIJIANG_TTS_TIMEOUT_SECONDS=900
ZHIJIANG_TTS_VOICE=notebook-reference
ZHIJIANG_DEFAULT_VOICE_MODE=ai
ZHIJIANG_QWEN_TTS_MODEL_DIR=data/models/qwen3-tts-0.6b-base
ZHIJIANG_QWEN_TTS_REFERENCE=data/voice-reference/voice.json
ZHIJIANG_QWEN_TTS_DEVICE=auto
ZHIJIANG_QWEN_TTS_CODEC_DEVICE=cpu
ZHIJIANG_QWEN_TTS_QUANTIZATION=none
ZHIJIANG_QWEN_TTS_IDLE_SECONDS=60
# 也可使用旧 Kokoro 服务：模型 kokoro-82m-v1.1-zh，音色 zf_001。
# 外部语音服务可改用自己的地址、模型、音色，并设置 ZHIJIANG_TTS_API_KEY。
