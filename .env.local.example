# 复制为 .env.local 后按本机模型名调整；.env.local 已加入 .gitignore。
ZHIJIANG_LLM_PROVIDER=ollama
ZHIJIANG_LLM_BASE_URL=http://127.0.0.1:11434
ZHIJIANG_LLM_MODEL=qwen2.5:7b

# 可选在线语音服务；Ollama 自身当前不提供本项目需要的 /audio/speech WAV 接口。
# ZHIJIANG_TTS_BASE_URL=https://your-tts-provider.example/v1
# ZHIJIANG_TTS_API_KEY=replace-me
# ZHIJIANG_TTS_MODEL=your-tts-model
# ZHIJIANG_TTS_VOICE=your-voice
