# 复制为 .env.local 后按本机模型名调整；.env.local 已加入 .gitignore。
ZHIJIANG_LLM_PROVIDER=ollama
ZHIJIANG_LLM_BASE_URL=http://127.0.0.1:11434
ZHIJIANG_LLM_MODEL=qwen3:4b

# 本机 Kokoro 中文 AI 配音；先安装 local-tts 依赖、下载模型并启动 8766 端口服务。
# Ollama 自身不提供本项目需要的 /audio/speech WAV 接口。
ZHIJIANG_TTS_BASE_URL=http://127.0.0.1:8766/v1
ZHIJIANG_TTS_MODEL=kokoro-82m-v1.1-zh
ZHIJIANG_TTS_VOICE=zf_001
# 外部语音服务可改用自己的地址、模型、音色，并设置 ZHIJIANG_TTS_API_KEY。
